{
  "name": "@forms-engine/renderer",
  "version": "1.1.0",
  "description": "Forms-Engine framework-agnostic questionnaire renderer web component (<forms-engine>).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoshuaLeoSmith/forms-engine.git",
    "directory": "packages/renderer"
  },
  "homepage": "https://github.com/JoshuaLeoSmith/forms-engine#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./element": "./dist/forms-engine.esm.js"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/index.js",
    "./dist/forms-engine.esm.js"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "lit": "^3.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "jsdom": "^28.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0"
  }
}
